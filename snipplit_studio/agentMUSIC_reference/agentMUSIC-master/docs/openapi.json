  "components": {
    "schemas": {
      "Body_upload_track_api_tracks_upload_post": {
        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_upload_track_api_tracks_upload_post"
      },
      "GenerateRequest": {
        "properties": {
          "chorus_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 128
              },
              {
                "type": "null"
              }
            ],
            "title": "Chorus Id"
          },
          "scenario": {
            "type": "string",
            "enum": [
              "karaoke",
              "slideshow",
              "track_promo",
              "cover_alive",
              "pov_spotify"
            ],
            "title": "Scenario",
            "default": "karaoke"
          },
          "bg_type": {
            "type": "string",
            "enum": [
              "footage",
              "animated"
            ],
            "title": "Bg Type",
            "default": "footage"
          },
          "orientation": {
            "type": "string",
            "enum": [
              "portrait",
              "landscape"
            ],
            "title": "Orientation",
            "default": "portrait"
          },
          "videos_per_account": {
            "type": "integer",
            "maximum": 10.0,
            "minimum": 1.0,
            "title": "Videos Per Account",
            "default": 1
          },
          "topic": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 4096
              },
              {
                "type": "null"
              }
            ],
            "title": "Topic"
          }
        },
        "type": "object",
        "title": "GenerateRequest"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "MinioBatchImportRequest": {
        "properties": {
          "keys": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Keys"
          }
        },
        "type": "object",
        "required": [
          "keys"
        ],
